# ==========================================
# AGRI-COOP ERP ENVIRONMENT CONFIGURATION
# ==========================================

# Node & Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Isolated Docker Database Ports (Prevent collisions with legacy services on 5432, 27017, 6379)
POSTGRES_PORT=5433
MONGO_PORT=27018
REDIS_PORT=6380

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_placeholder
POSTGRES_DB=agri_erp_db
DATABASE_URL=postgresql://postgres:postgres_password_placeholder@127.0.0.1:5433/agri_erp_db?schema=public

# MongoDB Configuration (Prepared for future Epics)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=mongo_password_placeholder
MONGO_DATABASE=agri_erp_logs

# Redis Configuration (Prepared for future Epics)
REDIS_PASSWORD=redis_password_placeholder

# JWT Authentication (Epic 2 Extended Scope)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_chars_placeholder
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars_placeholder
JWT_REFRESH_EXPIRATION=7d

# Google OAuth (Epic 2 Extended Scope)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Web Client Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
